<!-- Data Table -->
<section class="py-5 {{ tableData.background_class | default('') }}">
  <div class="container{{ tableData.container_fluid | default('') }} fade-in">
    <div class="row justify-content-center">
      <div class="col-lg-{{ tableData.col_width | default('10') }}">
        {% if tableData.title %}
        <h2 class="display-5 fw-bold text-center mb-4">{{ tableData.title }}</h2>
        {% endif %} {% if tableData.description %}
        <p class="lead text-center mb-5">{{ tableData.description }}</p>
        {% endif %}

        <div class="table-responsive">
          <table class="table table-striped table-hover">
            <thead class="table-primary">
              <tr>
                {% for header in tableData.headers %}
                <th scope="col">{{ header }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in tableData.data %}
              <tr>
                <!-- If there is only one cell in the row, make it span all cols -->
                {% if row | length == 1 %}
                <td colspan="{{ tableData.headers | length }}">{{ row.content[0] }}</td>
                {% else %} {% for cell in row.content %} {% if loop.index == 8 %}
                <td>
                  <a href="{{ row.link }}" class="btn btn-primary fs-5">{{ cell }}</a>
                </td>
                {%elif loop.index == 3 %}
                <td style="font-size: 15px">{{ cell }}</td>
                {% else %}
                <td>{{ cell }}</td>
                {% endif %} {% endfor %} {% endif %}
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
