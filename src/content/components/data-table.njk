<!-- Data Table -->
<section class="py-5 {{ tableData.background_class | default('') }}">
  <div class="container{{ tableData.container_fluid | default('') }} fade-in">
    <div class="row justify-content-center">
      <div class="col-lg-{{ tableData.col_width | default('10') }}">
        {% if tableData.title %}
        <h2>{{ tableData.title }}</h2>
        {% endif %}

        <div class="table-responsive">
          <table class="table table-dark table-striped table-hover">
            <thead class="table-danger">
              <tr>
                {% for header in tableData.headers %}
                <th scope="col" style="background-color: #010101; color: #ffff">{{ header }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in tableData.data %}
              <tr>
                <!-- If there is only one cell in the row, make it span all cols -->
                {% if row.content | length == 1 %}
                <td colspan="{{ tableData.headers | length }}">{{ row.content[0] }}</td>
                {% else %} {% for cell in row.content %} {% if loop.index == 1 %}
                <td>
                  {% if row.link and row.link | length %} {% for link in row.link %}<a
                    href="{{ link }}"
                    style="text-decoration: underline"
                  >
                    {{ row.linkDisplay[loop.index - 1] }}</a
                  ><br />
                  {% endfor %} {% else %} {{ cell }} {% endif %}
                </td>
                {%elif loop.index == 5 %}
                <td style="{{ row.descSize }}">{{ cell }}</td>
                {% else %}
                <td style="font-size: 20px">{{ cell }}</td>
                {% endif %} {% endfor %} {% endif %}
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
