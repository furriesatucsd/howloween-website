<section class="py-5 {{ tableData.background_class | default('') }}">
  <div class="container{{ tableData.container_fluid | default('') }} fade-in">
    <div class="row justify-content-center">
      <div class="col-lg-{{ tableData.col_width | default('10') }}">
        {% if tableData.title %}
        <h2>{{ tableData.title }}</h2>
        {% endif %}

        <div class="table-responsive">
          <table class="table table-striped table-hover">
            <thead class="table-primary">
              <tr>
                {% for header in tableData.headers %}
                <th scope="col" style="background-color: #010101; color: #ffff">{{ header }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in tableData.data %}
              <tr>
                <!-- If there is only one cell in the row, make it span all cols -->
                {% for cell in row.content %} {% if loop.index == 1 %}
                <td>
                  <img src="../../assets/images/food&discounts/{{ cell }}" alt="{{ cell }}" />
                </td>
                {%elif loop.index == 2%}
                <td style="font-size: 20px">
                  <a
                    href="{{row.link[0]}}"
                    style="color: #007bff; text-decoration: underline; font-size: 16px"
                    >{{cell}}</a
                  >
                </td>
                {% else %}
                <td style="font-size: 20px">{{ cell }}</td>
                {% endif %} {% endfor %}
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
